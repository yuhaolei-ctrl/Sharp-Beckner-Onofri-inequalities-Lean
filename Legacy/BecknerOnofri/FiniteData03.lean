theorem stage_correct (d : Nat) (hd : d ≤ 10) : shellArray 3 d = stage d := by
  induction d with
  | zero => rfl
  | succ d ih =>
      rw [shellArray_succ, ih (by omega), ← row_correct]
      exact steps_correct ⟨d, by omega⟩
