noncomputable def psi : ℝ → ℝ := convexMinorant (3/40) (1/16) pieces
theorem small_check : minorantSmallCheck (3/40) (1/16) pieces=true := by decide +kernel
theorem psi_small {x : ℝ} (hx : x≤1/16) : psi x=(3/40 : ℝ)*x^4 := by
  simpa only [psi,Rat.cast_div,Rat.cast_ofNat,Rat.cast_one] using
    minorantSmallCheck_sound (3/40) (1/16) (by norm_num) pieces small_check (by simpa only [Rat.cast_div,Rat.cast_ofNat,Rat.cast_one] using hx)
theorem psi_continuous : Continuous psi := convexMinorant_continuous _ _ _
theorem psi_convex : ConvexOn ℝ univ psi := convexMinorant_convex _ _ (by norm_num) _
theorem piece_le_psi (i : Fin pieces.length) (x : ℝ) : (pieces[i]).value x≤psi x :=
  affinePiece_le_convexMinorant _ _ pieces _ (List.getElem_mem i.isLt) x
#print axioms psi_small
#print axioms psi_convex
end BecknerOnofri.HighDim.ScalarCertificate.CertifiedMinorant
