def fastGradientBound (p L : Count → ℚ) (j : Count) : ℚ :=
  2*L j+2-2*(∑ k : Count,materializedInteraction j k*p k)
def fastFunctionalLower (p L : Count → ℚ) : ℚ :=
  2*(∑ j : Count,p j*L j)-(∑ i : Count, ∑ j : Count,p i*materializedInteraction i j*p j)
theorem fastGradientBound_eq (p L : Count → ℚ) (j : Count) :
    fastGradientBound p L j=rationalGradientBound p L j := by
  simp only [fastGradientBound, rationalGradientBound, materializedInteraction_eq]
theorem fastFunctionalLower_eq (p L : Count → ℚ) :
    fastFunctionalLower p L=rationalFunctionalLower p L := by
  simp only [fastFunctionalLower, rationalFunctionalLower, quadraticQ, materializedInteraction_eq]
