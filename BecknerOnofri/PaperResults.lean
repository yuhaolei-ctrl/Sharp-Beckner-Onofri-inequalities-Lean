      (67/100) * (∑' n : ℕ, (ConditionalEntropy.conditionalCosineMoment f i (n+3) x)^2 / (n+3 : ℝ)) ≤
        ConditionalEntropy.conditionalEntropy f i x := ConditionalEntropy.conditional_gamma V hc hconv hmono f hrep a ha he i x























