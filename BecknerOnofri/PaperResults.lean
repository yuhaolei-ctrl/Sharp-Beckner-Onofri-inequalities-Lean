open HighDim Set MeasureTheory Legacy.BecknerOnofri.ThetaDomination

/-- **Lemma 3.2** (lem:E1-bound). -/
theorem e1_bound {x : ℝ} (hx : 0 < x) :
    Real.exp x * ∫ r in Ioi (1 : ℝ), Real.exp (-x * r) / r <
      (x ^ 2 + 5 * x + 2) / (x * (x ^ 2 + 6 * x + 6)) :=
  ThetaElementary.exp_mul_integral_exp_div_lt hx

/-- **Lemma 3.3** (lem:theta-integral-certificate), the case `d = 12`: `J₁₂ < 3.29`. -/
theorem twelve_theta_integral : thetaIntegral realTheta 12 < 329 / 100 :=
  Twelve.ThetaBound.thetaIntegral_lt

/-- **Lemma 5.13** (lem:section5-global-scalar-tail): `T_n ≤ R_n` with `c = 0.67`, `ε = 0.042`. -/
theorem scalar_tail_bound (n : ℕ) : EntropyTail.scalarTail n ≤ EntropyTail.scalarBudget n :=
  EntropyTail.scalarTail_le_budget n

/-- **Lemma 5.17** (lem:section5-global-small-gamma): `γ(t) ≥ ψ(t)` on `[0,1)`. -/
theorem small_gamma (t : ℝ) (ht : t ∈ Ico (0 : ℝ) 1) : Spin.psi t ≤ CircleScalar.gamma t :=
  psi_le_gamma t ht

/-- **Lemma 5.18** (lem:section5-jensen-remainder), pointwise Bregman form. -/
theorem jensen_remainder {t s : ℝ} (ht0 : 0 ≤ t) (ht1 : t < 1) (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    0 ≤ Spin.jensenGap t s :=
  Spin.jensenGap_nonneg ht0 ht1 hs0 hs1

/-- **Lemma 5.19** (lem:section5-global-curvature). -/
theorem fixed_mean_curvature {p q : Spin.Count → ℝ} (hp : Spin.Feasible p)
    (hpos : ∀ j, 0 < p j) (hmass : (∑ j : Spin.Count, q j) = 0) (hmean : Spin.mean q = 0) :
    Spin.quadratic q ≤ (43 / 50) * ∑ j : Spin.Count, q j ^ 2 / p j :=
  Spin.fixed_mean_curvature_sharp hp hpos hmass hmean

/-- The reduction `G_t(p) ≥ 𝓑(t)` preceding Lemma 5.20. -/
theorem pressure_reduction {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1) {p : Spin.Count → ℝ}
    (hp : Spin.FeasibleAt t p) : Spin.pressureScalar t ≤ Spin.penalized t p :=
  Spin.pressureScalar_le_penalized ht0 ht1 hp

/-- **Lemma 5.20** (lem:section5-scalar-pressure), on `[1/16, 0.99]`. -/
theorem scalar_pressure (t : ℝ) (ht : t ∈ Icc (1 / 16 : ℝ) (99 / 100)) :
    t ^ 4 / 200 < Spin.pressureScalar t :=
  pressureScalar_gt t ht

/-- **Proposition 5.10** (prop:section5-global-entropy-gap), with the manuscript's shape
hypotheses: reality and nonnegativity of `ρ̂(e₁)`, the bound `ρ̂(e₁)⁴/200`, and rigidity. -/
alias global_entropy_gap := ShapeEntropy.global_shape_entropy

/-- **Proposition 5.12(i)** (prop:section5-spin-entropy) for an admissible density. -/
alias channel_entropy := ShapeEntropy.channel_fourier_entropy_eta

/-- **Proposition 5.12(ii)** (prop:section5-spin-entropy). -/
theorem finite_state_inequality {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) {p : Spin.Count → ℝ}
    (hp : Spin.FeasibleAt t p) : t ^ 4 / 200 ≤ Spin.penalized t p :=
  Spin.finite_state_inequality_of_pressure pressureScalar_gt ht hp

/-- **Lemma 3.6** (lem:mixture-transfer) at `β = 2d`, the case used in Proposition 3.7: a
nonuniform countable cosine mixture has a strict entropy gap. -/
theorem mixture_transfer {d : ℕ} (hd2 : 2 ≤ d) (hd10 : d ≤ 10)
    (w : ℕ → ℝ) (N : ℕ → Fin d → ℕ) (hw : ∀ n, 0 ≤ w n) (hm : HasSum w 1)
    (hSup : Summable (fun n => w n * Legacy.BecknerOnofri.CosineMixture.tensor (N n) 0))
    (a : ℕ) (hN : N a ≠ 0) :
    Legacy.BecknerOnofri.endpointConstant d *
        Legacy.BecknerOnofri.fourierEnergy
          (Legacy.BecknerOnofri.CosineMixtureApproximation.probabilityDensity w N hw hm hSup) +
      w a * w a * Legacy.D10.latentWeight (N a) (N a) (N a) *
        Legacy.BecknerOnofri.StrictMixture.gap d / 2 ≤
      Legacy.TorusEndpoint.densityEntropy
        (Legacy.BecknerOnofri.CosineMixtureApproximation.probabilityDensity w N hw hm hSup).value :=
  Legacy.BecknerOnofri.StrictMixture.countable_mixture_gap hd2 hd10 w N hw hm hSup a hN

end BecknerOnofri.PaperResult
