open Lean Elab Command

/-- Union of axioms used by every constant declared in a module whose name starts with `BecknerOnofri.V2`,
and by the constants of `SolutionRoute`, `SolutionV2`. Reports the offending constants if any. -/
elab "#scan_axioms " out:str : command => do
  let env ← getEnv
  let std : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let mut n := 0
  let mut bad : Array String := #[]
  let mut union : NameSet := {}
  for (c, ci) in env.constants.map₁.toList do
    let some mi := env.getModuleIdxFor? c | continue
    let m := (env.header.moduleNames[mi.toNat]!).toString
    unless m.startsWith "BecknerOnofri.V2" || m == "SolutionRoute" || m == "SolutionV2" do continue
    if c.isInternal then continue
    match ci with
    | .thmInfo _ | .defnInfo _ | .opaqueInfo _ =>
      n := n + 1
      let axs ← liftCoreM (collectAxioms c)
      for a in axs do
        union := union.insert a
        unless std.contains a do bad := bad.push s!"{c} uses {a}"
    | .axiomInfo _ => bad := bad.push s!"{c} is itself an axiom ({m})"
    | _ => pure ()
  IO.FS.writeFile out.getString (s!"constants_scanned\t{n}\naxioms_union\t{union.toList}\nviolations\t{bad.size}\n" ++ "\n".intercalate bad.toList ++ "\n")

